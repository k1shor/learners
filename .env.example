# Copy this file to .env and fill in only the values needed for your environment.
# APP_BASE_URL should be the public URL of the Vite frontend.
APP_BASE_URL=http://localhost:5173

# Production only: set a random key with at least 32 characters.
# Generate one with PowerShell: [Convert]::ToHexString((1..32 | % { [byte](Get-Random -Max 256) }))
ADMIN_API_KEY=

# Mail provider SMTP settings are required to deliver reset links in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
